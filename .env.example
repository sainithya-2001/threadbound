# Create an app in the Twitch Developer Console and register this exact redirect URL.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
APP_BASE_URL=http://localhost:4173
TWITCH_REDIRECT_URI=http://localhost:4173/auth/twitch/callback
# Generate a private 32-byte key (base64url or 64 hex characters). Required for persistent OAuth storage.
THREADBOUND_ENCRYPTION_KEY=replace_with_32_byte_base64url_key
# Required for live conversation-intelligence drafts. Keep this server-side.
OPENAI_API_KEY=your_openai_api_key
# Optional; defaults to gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
# Set DEMO_MODE=true to ignore Twitch/OpenAI credentials from this file, skip token storage,
# and disable OAuth, EventSub, chat capture, AI requests, and AI consent for this process.
DEMO_MODE=false
# Optional; defaults to data/threadbound.sqlite
# THREADBOUND_TOKEN_DB=data/threadbound.sqlite
HOST=0.0.0.0
PORT=4173
